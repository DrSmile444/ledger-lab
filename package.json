{
  "name": "ledger-lab",
  "version": "0.1.0",
  "main": "src/main.ts",
  "scripts": {
    "start": "npx tsx ./src/main.ts",
    "lint": "cross-env TIMING=1 npx eslint",
    "lint:fix": "npm run lint -- --fix",
    "lint:debug": "npm run lint -- --debug",
    "format:md": "npx prettier --write \"**/*.md\"",
    "typecheck": "npx tsc --noEmit",
    "test": "npx vitest",
    "test:run": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "bump-version": "npx tsx ./scripts/bump-version.script.ts && npm audit fix",
    "parse-llm-response": "npx tsx ./scripts/split-plain-code.wrap.ts",
    "after-parse-llm-response": "npx tsx ./scripts/create-auto-ts-paths.script.ts && npm run lint:fix && npm run format:md",
    "format": "npx prettier . --write",
    "generate:env-template": "npx tsx ./scripts/generate-env-template.ts",
    "postinstall": "./scripts/link-codex-skills.sh"
  },
  "keywords": [
    "typescript",
    "openspec",
    "banking-domain",
    "vitest",
    "demo"
  ],
  "author": "Dmytro Vakulenko",
  "license": "ISC",
  "description": "Minimal in-memory banking ledger core (accounts, transactions) used as the base for a live OpenSpec + Claude Code demo.",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.1.31",
    "@dword-design/eslint-plugin-import-alias": "^8.1.8",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "cross-env": "^10.1.0",
    "deepmerge": "^4.3.1",
    "eslint": "^10.2.1",
    "eslint-config-naming": "^1.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-import-zod": "^1.2.1",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-lintlord": "^1.2.0",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-no-barrel-files": "^1.3.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-zod": "^4.7.0",
    "globals": "^17.5.0",
    "json5": "^2.2.3",
    "prettier": "^3.8.3",
    "ts-declaration-location": "^1.0.7",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^22.21.0 || >=24.10.0"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:DrSmile444/ledger-lab.git"
  }
}
